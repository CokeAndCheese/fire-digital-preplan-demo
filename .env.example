# Copy to .env on the Lighthouse host and chmod 600 .env.
# Never commit the real .env or put credentials in this file.

FIRE_BASE_PATH=/fire-digital-preplan-demo
SCENE_BASE_PATH=/fire-digital-preplan-demo/scene
# Same-origin browser path; this also remains valid after adding a domain/HTTPS.
FIRE_PUBLIC_SCENE_URL=/fire-digital-preplan-demo/scene
BROWSER_X_APP_KEY_CONFIRMED=false
OLD_EMBEDDED_CREDENTIALS_REVOKED=false
# Current demo APIs have no end-user login. Set true only after explicitly
# accepting public unauthenticated demo access, or after adding a real guard.
PUBLIC_UNAUTHENTICATED_DEMO_CONFIRMED=false

# Fire command agent runtime
AGENT_RUNTIME_MODE=remote
AGENT_GATEWAY=https://fc.xwbuilders.com
AGENT_APP_KEY=
AGENT_COMPETITION_APP_ID=
AGENT_MAIN_APP_ID=
AGENT_STREAM_TIMEOUT_MS=90000
AGENT_GATEWAY_TIMEOUT_MS=12000

# Server-only bridge settings. The base path is intentional: service-to-service
# calls exercise the same prefixed Next routes that Caddy exposes.
SCENE_CONTROL_URL=http://fire-digital-preplan-demo-scene:3000/fire-digital-preplan-demo/scene
ROUTE_WATER_URL=http://fire-digital-preplan-demo-scene:3000/fire-digital-preplan-demo/scene/api/skill-bridge/route-water
RESPONSE_LEVEL_URL=
RESCUE_PLAN_URL=
COMPETITION_ORCHESTRATOR_URL=
FIRE_RESOURCE_PLATFORM_URL=https://platform.sanya119.online
SKILL_BRIDGE_TOKEN=
PLAN_TEMPLATE_KB_URL=
PLAN_TEMPLATE_KB_TOKEN=
FIRE_COMMAND_AGENT_URL=http://fire-digital-preplan-demo:3100/fire-digital-preplan-demo

# Persistent fire plan data. The host-side ./data/fire directory is mounted here.
FIRE_PLAN_STORAGE_PATH=/app/data/fire/plans.json
FIRE_PLAN_TEMPLATE_PATH=
FIRE_PLAN_EXPORT_DIR=/app/data/fire/exports
FIRE_PLAN_API_TOKEN=

# Scene service runtime/build-compatible public settings.
# X_APP_KEY is delivered to the browser by the current UStudio SDK. Use only a
# newly issued, browser-scoped least-privilege key; never reuse the quarantined
# desktop-package credential or a high-privilege server secret.
X_APP_KEY=
USTUDIO_GATEWAY=https://fc.xwbuilders.com
USTUDIO_HTTP_BASE_URL=
USTUDIO_ASSET_BASE_URL=
NEXT_PUBLIC_DEFAULT_SCENE_ID=477747327523254272
NEXT_PUBLIC_JARVIS_WORKSPACE_ID=
NEXT_PUBLIC_LOCALE=zh
