      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="SoonSpace 模板、SDK、WebSocket 与生成项目调用关系" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="30" width="1200" height="50" as="geometry" />
        </mxCell>

        <mxCell id="template-box" value="A. 模板源码&#xa;resources/workspace-template-soonspace" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;fontStyle=1;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="110" width="420" height="620" as="geometry" />
        </mxCell>
        <mxCell id="tpl-package" value="package.json / package-lock.json&#xa;固定 SDK 版本&#xa;soonspacejs 2.15.14&#xa;@soonspacejs/plugin-* 2.15.14&#xa;soonspacejs-ustudio-plugin 1.0.19" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="170" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="tpl-viewer" value="components/SoonspaceSceneViewer.tsx&#xa;读取 SceneBootstrap&#xa;创建 SoonspaceRuntime&#xa;创建 PluginManager&#xa;挂载 __scenePlugins 桥" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="295" width="360" height="95" as="geometry" />
        </mxCell>
        <mxCell id="tpl-runtime" value="lib/soonspace-runtime.ts&#xa;封装 SDK 实例、场景渲染、截图、GIS、路径、多边形、语义点击、2D/3D 切换" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="410" width="360" height="85" as="geometry" />
        </mxCell>
        <mxCell id="tpl-ustudio" value="lib/ustudio.ts&#xa;封装 UStudio 数据/API&#xa;场景树、属性、路径、连通性、可达性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="515" width="360" height="70" as="geometry" />
        </mxCell>
        <mxCell id="tpl-ws" value="lib/websocket.ts + lib/syscall.ts&#xa;连接/解码 WebSocket&#xa;执行 function_identifier / script_content&#xa;统一回 function_invoke_replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="605" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="sdk-box" value="B. SDK / npm 依赖层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=17;fontStyle=1;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="530" y="110" width="420" height="620" as="geometry" />
        </mxCell>
        <mxCell id="sdk-core" value="soonspacejs&#xa;核心场景引擎&#xa;Scene、Object3D、相机、渲染循环、拾取、视图控制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="170" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sdk-plugins" value="@soonspacejs/plugin-*&#xa;atmosphere / effect / fds / flow / gs3d-loader / poi-renderer / tiles / cps-soonmanager&#xa;给 soonspacejs 注入加载、特效、POI、瓦片等能力" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="270" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="sdk-ustudio" value="soonspacejs-ustudio-plugin&#xa;UStudio 语义适配层&#xa;场景树、楼栋/楼层、语义对象、可达/连通图、路线/多边形数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="395" width="360" height="90" as="geometry" />
        </mxCell>
        <mxCell id="sdk-three" value="three / camera-controls / postprocessing&#xa;底层 3D 能力与渲染辅助依赖，由 soonspacejs 和模板运行时共同使用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="505" width="360" height="75" as="geometry" />
        </mxCell>
        <mxCell id="sdk-contract" value="依赖边界&#xa;模板只声明版本和调用 API&#xa;实际代码由生成项目 npm install 安装到 node_modules&#xa;SDK 升级通过模板 package.json 进入新项目" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9673a6;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="560" y="600" width="360" height="95" as="geometry" />
        </mxCell>

        <mxCell id="generate-box" value="C. 生成/同步流程" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=17;fontStyle=1;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="1010" y="110" width="360" height="620" as="geometry" />
        </mxCell>
        <mxCell id="gen-copy" value="1. 复制模板文件&#xa;app / components / lib / public / docs / package.json" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="170" width="300" height="70" as="geometry" />
        </mxCell>
        <mxCell id="gen-inject" value="2. 注入项目上下文&#xa;sceneId、appKey、接口地址、环境变量、生成面板定义、项目业务代码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="260" width="300" height="85" as="geometry" />
        </mxCell>
        <mxCell id="gen-install" value="3. 安装依赖&#xa;npm install 读取生成项目 package.json&#xa;写入/使用 package-lock.json，生成 node_modules" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="365" width="300" height="85" as="geometry" />
        </mxCell>
        <mxCell id="gen-run" value="4. 启动预览&#xa;Next dev server&#xa;Jarvis 工作台 iframe 加载生成项目页面" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="470" width="300" height="75" as="geometry" />
        </mxCell>
        <mxCell id="gen-rule" value="同步规则&#xa;生成项目是模板的独立副本。&#xa;模板后续修复不会自动进入旧项目；旧项目需要重新生成、同步脚本或手动补丁。&#xa;SDK 版本也以生成项目自己的 package.json 为准。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#d6b656;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1040" y="565" width="300" height="130" as="geometry" />
        </mxCell>

        <mxCell id="project-box" value="D. 生成项目 / 工作区&#xa;%LOCALAPPDATA%/jarvis_data/workspaces/&lt;project&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;fontStyle=1;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="1430" y="110" width="420" height="620" as="geometry" />
        </mxCell>
        <mxCell id="proj-files" value="源码副本&#xa;app、components、lib、docs、public&#xa;可按项目业务继续修改" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1460" y="170" width="360" height="75" as="geometry" />
        </mxCell>
        <mxCell id="proj-deps" value="依赖副本&#xa;package.json / package-lock.json / node_modules&#xa;安装 soonspacejs 与 @soonspacejs/plugin-*" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1460" y="265" width="360" height="80" as="geometry" />
        </mxCell>
        <mxCell id="proj-boot" value="页面启动&#xa;app 页面加载 SceneBootstrap&#xa;SoonspaceSceneViewer mount&#xa;创建 runtime + pluginManager + agent websocket" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1460" y="365" width="360" height="95" as="geometry" />
        </mxCell>
        <mxCell id="proj-runtime" value="浏览器运行态&#xa;SoonspaceRuntime 持有 SDK 实例&#xa;UStudioSceneTool 插件持有 runtime/treeData/sceneId&#xa;PanelShell / generated-panel-runtime 管理业务面板" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1460" y="480" width="360" height="105" as="geometry" />
        </mxCell>
        <mxCell id="proj-preview" value="用户与预览&#xa;Jarvis WorkPane iframe 加载项目 URL&#xa;用户操作插件面板 / 业务面板&#xa;WebSocket 指令也作用于同一运行态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1460" y="605" width="360" height="90" as="geometry" />
        </mxCell>

        <mxCell id="websocket-box" value="E. WebSocket 调用链" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=17;fontStyle=1;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="810" width="1120" height="560" as="geometry" />
        </mxCell>
        <mxCell id="ws-server" value="WebSocket 服务端&#xa;发送 function_msg&#xa;data.jsonData 包含 scene_id、message_id、function_identifier、params、script_content、instance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="875" width="250" height="100" as="geometry" />
        </mxCell>
        <mxCell id="ws-decode" value="lib/websocket.ts&#xa;建立连接&#xa;protobuf/json 解码&#xa;收到 message 后交给 startSceneAgent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="875" width="230" height="100" as="geometry" />
        </mxCell>
        <mxCell id="syscall-entry" value="lib/syscall.ts executeModel&#xa;校验 scene_id&#xa;识别 function_identifier / script_content&#xa;构造脚本方法上下文 ScriptMethods" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="875" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="dispatch" value="分发路径&#xa;A. function_identifier 直调&#xa;B. script_content eval 执行&#xa;C. 兼容无 return 的 panelList / panelSetVisible 回包" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="950" y="875" width="190" height="100" as="geometry" />
        </mxCell>
        <mxCell id="scene-methods" value="场景对象方法&#xa;fly / highlight / opacity / hide / show / getProperty / pathMove / screenshot / video / drawRoute" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f0;strokeColor=#b85450;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="1040" width="250" height="105" as="geometry" />
        </mxCell>
        <mxCell id="plugin-methods" value="插件面板方法&#xa;layerGetState / layerApply&#xa;gisSetVisible&#xa;routeSetVisible&#xa;polygonSetVisible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f0;strokeColor=#b85450;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="380" y="1040" width="230" height="105" as="geometry" />
        </mxCell>
        <mxCell id="panel-methods" value="业务面板方法&#xa;panelList&#xa;panelSetVisible&#xa;togglePanel / movePanel / reportPanels&#xa;通过 PanelShell 与 generated-panel-runtime 生效" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2f0;strokeColor=#b85450;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="660" y="1040" width="240" height="105" as="geometry" />
        </mxCell>
        <mxCell id="reply" value="统一回包&#xa;sendFunctionSuccess / sendFunctionError&#xa;messageType=function_invoke_replay&#xa;data.jsonData={status,messageId,result/data/message}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="950" y="1040" width="190" height="105" as="geometry" />
        </mxCell>
        <mxCell id="ws-notes" value="WebSocket 调用特点&#xa;1. script_content 可组合多个方法，也可 return 返回值。&#xa;2. function_identifier 更适合服务端结构化调用。&#xa;3. 参数兼容层会处理 boolean 字符串、JSON 数组字符串、别名字段。&#xa;4. 最终都落到生成项目浏览器运行态，不在服务端直接操作 3D 场景。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#b85450;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="1205" width="1060" height="120" as="geometry" />
        </mxCell>

        <mxCell id="runtime-box" value="F. 生成项目内部运行态调用链" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2f0d9;strokeColor=#82b366;fontSize=17;fontStyle=1;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="1230" y="810" width="1120" height="560" as="geometry" />
        </mxCell>
        <mxCell id="rt-page" value="Next App 页面&#xa;读取启动数据&#xa;渲染 SoonspaceSceneViewer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1260" y="875" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rt-viewer" value="SoonspaceSceneViewer&#xa;创建 runtime&#xa;attach PluginManager&#xa;startSceneAgent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1510" y="875" width="210" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rt-runtime" value="SoonspaceRuntime&#xa;封装 soonspacejs / UStudio 插件实例&#xa;提供 draw、highlight、viewMode、GIS、route、polygon 等命令" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1760" y="875" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="rt-sdk" value="SDK 实例&#xa;soonspacejs core&#xa;@soonspacejs/plugin-*&#xa;soonspacejs-ustudio-plugin" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2050" y="875" width="250" height="95" as="geometry" />
        </mxCell>
        <mxCell id="rt-plugin-manager" value="PluginManager&#xa;注册 UStudioSceneTool&#xa;管理启用状态、持久化、PluginPanel 控件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1035" width="210" height="95" as="geometry" />
        </mxCell>
        <mxCell id="rt-plugin" value="UStudioSceneTool&#xa;读取 treeData / sceneId / runtime&#xa;applyLayer 控制楼栋楼层、2D/3D、炸开、标注、可达性、连通性&#xa;setRoutesVisible / setPolygonsVisible 渲染虚拟对象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1510" y="1035" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rt-panel" value="生成业务面板&#xa;PanelShell 负责挂载/展开/关闭&#xa;generated-panel-runtime 提供 panelList / panelSetVisible&#xa;generated-panels 记录 id/name/domId/aliases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1800" y="1035" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rt-api" value="UStudio / 后端 API&#xa;routes/detail、polygons/detail&#xa;reachable、connectivity&#xa;场景树和属性数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82b366;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="2090" y="1035" width="210" height="120" as="geometry" />
        </mxCell>
        <mxCell id="rt-bridge" value="__scenePlugins 桥&#xa;把 layerApply / gisSetVisible / routeSetVisible / polygonSetVisible / panelList / panelSetVisible 暴露给脚本环境&#xa;WebSocket 与 UI 共用同一插件实例" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#82b366;align=left;verticalAlign=top;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1260" y="1215" width="1040" height="105" as="geometry" />
        </mxCell>

        <mxCell id="sdk-detail-box" value="G. SDK 各包能力细化与落点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3eaf7;strokeColor=#9673a6;fontSize=17;fontStyle=1;verticalAlign=top;spacingTop=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="1420" width="2300" height="680" as="geometry" />
        </mxCell>
        <mxCell id="sdk-cap-core" value="soonspacejs core&#xa;场景容器与生命周期&#xa;模型/对象树与 Object3D 管理&#xa;相机、飞行定位、视图控制&#xa;拾取、事件、渲染循环、截图基础" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="1490" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="sdk-cap-gs3d" value="@soonspacejs/plugin-gs3d-loader&#xa;加载 GS3D / SoonSpace 场景资源&#xa;解析模型、语义构件、楼层空间数据&#xa;向 runtime 提供可检索的场景对象" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="1490" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="sdk-cap-tiles" value="@soonspacejs/plugin-tiles&#xa;GIS 底图 / 三维瓦片能力&#xa;tileset 加载与空间切片显示&#xa;对应 gisSetVisible、GIS 底图开关" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="1490" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="sdk-cap-poi" value="@soonspacejs/plugin-poi-renderer&#xa;POI / 标注 / 文本图标渲染&#xa;标注层可见性、层级、拾取事件&#xa;对应 layerApply.labels 与空间标注" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1220" y="1490" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="sdk-cap-flow" value="@soonspacejs/plugin-flow&#xa;路线、流线、路径可视化&#xa;方向动画、路径点连线、运动辅助&#xa;对应 drawRoute、routeSetVisible、pathMove" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1600" y="1490" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="sdk-cap-effect" value="@soonspacejs/plugin-effect&#xa;后处理、轮廓、选中反馈、视觉特效&#xa;支撑高亮、透明度、强调显示&#xa;对应 highlight / opacity / show / hide" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1980" y="1490" width="330" height="135" as="geometry" />
        </mxCell>
        <mxCell id="sdk-cap-atmosphere" value="@soonspacejs/plugin-atmosphere&#xa;天空、大气、日照与环境光&#xa;经纬度、海拔、时间驱动光照&#xa;对应 RenderSettingsTool 的开启大气" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="1660" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="sdk-cap-fds" value="@soonspacejs/plugin-fds&#xa;FDS / 仿真数据可视化能力&#xa;火灾、烟气、流场等专项叠加层&#xa;作为场景专项效果插件接入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="460" y="1660" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="sdk-cap-cps" value="@soonspacejs/plugin-cps-soonmanager&#xa;SoonManager 聚合插件包&#xa;依赖并注册 atmosphere / effect / fds / flow / gs3d / poi / tiles&#xa;模板通过 cps 访问具体插件实例" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="1660" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="sdk-cap-ustudio" value="soonspacejs-ustudio-plugin&#xa;UStudio 语义适配层&#xa;场景树、楼栋楼层、空间/构件语义&#xa;可达性、连通性、路线、多边形业务数据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1220" y="1660" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="sdk-cap-three" value="three / camera-controls / postprocessing&#xa;底层几何、材质、Vector3、相机控制&#xa;渲染后处理 composer / pass&#xa;被 soonspacejs 与模板 runtime 共同使用" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1600" y="1660" width="350" height="135" as="geometry" />
        </mxCell>
        <mxCell id="sdk-cap-runtime-map" value="模板封装后的运行时能力&#xa;SoonspaceRuntime 把 SDK 能力收束成稳定方法：&#xa;fly / highlight / opacity / show / hide / screenshot&#xa;viewMode / drawRoute / GIS / route / polygon&#xa;UStudioSceneTool 负责 layerApply 与语义联动" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#9673a6;align=left;spacing=10;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1980" y="1660" width="330" height="135" as="geometry" />
        </mxCell>
        <mxCell id="sdk-cap-call-chain" value="SDK 到生成项目调用链&#xa;1. 生成项目 npm install 安装这些包到 node_modules。&#xa;2. SoonspaceSceneViewer 创建 SoonspaceRuntime。&#xa;3. SoonspaceRuntime 初始化 soonspacejs、cps 插件、UStudio 插件。&#xa;4. PluginManager 注册 UStudioSceneTool / RenderSettingsTool 等模板插件。&#xa;5. UI 操作和 WebSocket 脚本都调用同一批 runtime/plugin 实例。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="1830" width="1070" height="200" as="geometry" />
        </mxCell>
        <mxCell id="sdk-cap-ws-map" value="能力到 WebSocket 方法映射&#xa;场景对象：soonspacejs core + effect → fly / highlight / opacity / hide / show / getProperty / screenshot&#xa;图层面板：UStudio + tiles + poi + flow → layerApply / gisSetVisible / routeSetVisible / polygonSetVisible&#xa;路径绘制：flow + runtime 覆盖层 → drawRoute / drawPath / pathMove&#xa;业务面板：不直接来自 SDK，由 PanelShell / generated-panel-runtime 管理，再通过 __scenePlugins 暴露" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=12;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1190" y="1830" width="1120" height="200" as="geometry" />
        </mxCell>

