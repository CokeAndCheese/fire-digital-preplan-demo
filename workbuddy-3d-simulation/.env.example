# 三维服务运行时配置示例。不要在此文件或任何交付包中填写真实凭据。
# 桌面程序使用外部 scene.env 在 standalone 启动后注入这些值。
# 当前 UStudio SDK 会在浏览器请求中使用该值。生产只允许填新签发、
# 来源受限且最小权限的浏览器专用 key；不要填高权限服务端秘密。
X_APP_KEY=
USTUDIO_GATEWAY=https://fc.xwbuilders.com
USTUDIO_HTTP_BASE_URL=
USTUDIO_ASSET_BASE_URL=
AGENT_GATEWAY=https://fc.xwbuilders.com

# Optional build-time mount path. Rebuild after changing this value.
NEXT_PUBLIC_BASE_PATH=

# 以下是非秘密的客户端构建配置；桌面脱敏构建会清空所有 NEXT_PUBLIC_* 值。
NEXT_PUBLIC_DEFAULT_SCENE_ID=477747327523254272
NEXT_PUBLIC_JARVIS_WORKSPACE_ID=
NEXT_PUBLIC_LOCALE=zh
