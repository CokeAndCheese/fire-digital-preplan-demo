{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fire rescue plan actions",
  "oneOf": [
    {
      "properties": {
        "action": { "const": "generate_plan" },
        "input": {
          "type": "object",
          "properties": {
            "building": { "type": "string", "minLength": 1 },
            "floor": { "type": "string" },
            "floorId": { "type": "string" },
            "room": { "type": "string" },
            "roomId": { "type": "string" },
            "fireType": { "type": "string" },
            "trappedCount": { "type": "integer", "minimum": 0 },
            "burnArea": { "type": "number", "minimum": 0 }
          },
          "required": ["building", "fireType"],
          "additionalProperties": false
        }
      },
      "required": ["action", "input"]
    },
    {
      "properties": {
        "action": { "const": "query_plan" },
        "input": {
          "type": "object",
          "properties": {
            "building": { "type": "string" },
            "limit": { "type": "integer", "minimum": 1, "maximum": 50 }
          },
          "additionalProperties": false
        }
      },
      "required": ["action", "input"]
    },
    {
      "properties": {
        "action": { "const": "publish_plan" },
        "input": {
          "type": "object",
          "properties": {
            "planId": { "type": "string", "minLength": 1 },
            "reviewer": { "type": "string", "minLength": 1 }
          },
          "required": ["planId", "reviewer"],
          "additionalProperties": false
        }
      },
      "required": ["action", "input"]
    }
  ]
}
