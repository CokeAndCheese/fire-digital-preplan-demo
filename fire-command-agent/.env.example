# 比赛现场运行时。默认 remote：localhost 仅为展示壳，业务处理走八维通。仅开发诊断时才设为 offline_demo。
AGENT_RUNTIME_MODE=remote
AGENT_GATEWAY=https://fc.xwbuilders.com
AGENT_APP_KEY=
# 只允许一个已发布比赛 app_id；必须同时更新 runtime-evidence/ustudio-competition-binding-manifest.json。
AGENT_COMPETITION_APP_ID=
# 已废弃：比赛运行时不再回退到 AGENT_MAIN_APP_ID。
AGENT_MAIN_APP_ID=
AGENT_STREAM_TIMEOUT_MS=90000
AGENT_GATEWAY_TIMEOUT_MS=12000

# Next.js 构建期部署前缀。为空表示部署在域名根路径；例如 /fire-digital-preplan-demo。
NEXT_PUBLIC_BASE_PATH=
# 三维场景地址独立于主应用 basePath；可为绝对 URL 或场景项目自己的路径。
NEXT_PUBLIC_SCENE_URL=http://localhost:3000

# 子项目 Skill Bridge。只在服务端使用，不能添加 NEXT_PUBLIC_ 前缀。
SCENE_CONTROL_URL=
RESPONSE_LEVEL_URL=
# 三维项目的动态路线/水源 Skill Bridge，例如 http://127.0.0.1:3000/api/skill-bridge/route-water
ROUTE_WATER_URL=http://127.0.0.1:3000/api/skill-bridge/route-water
RESCUE_PLAN_URL=
COMPETITION_ORCHESTRATOR_URL=
FIRE_RESOURCE_PLATFORM_URL=https://platform.sanya119.online
SKILL_BRIDGE_TOKEN=
FIRE_COMMAND_AGENT_URL=http://127.0.0.1:3100

# Unified plan store and signed Word export. Missing customer template blocks export.
FIRE_PLAN_STORAGE_PATH=
FIRE_PLAN_TEMPLATE_PATH=
FIRE_PLAN_EXPORT_DIR=
FIRE_PLAN_API_TOKEN=
